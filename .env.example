# FreeSound API key — get one at https://freesound.org/apiv2/apply
# Required for all API operations
FREESOUND_API_KEY=your_api_key_here

# Local path for downloaded sound files (default: data/sounds)
SFX_LOCAL_PATH=data/sounds

# SQLite database path (default: data/sfx_cache.db)
SFX_DB_PATH=data/sfx_cache.db

# In-memory log ring buffer size (default: 2000)
SFX_LOG_MAX_ENTRIES=2000
